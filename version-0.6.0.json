    {
      "noteVersion": 3,
      "content": "The function “F” (the host callback) used to handle calls to \\Omega_Y(\\dots, \\mathbf{i}) under \\mathtt{import}, but now the import call is replaced by \\mathtt{fetch} that calls \\Omega_Y(\\dots, i, p, \\mathbf{o}, \\overline{\\mathbf{i}}).",
      "date": 1738332674178,
      "author": "",
      "selectionStart": {
        "pageNumber": 45,
        "index": 379
      },
      "selectionEnd": {
        "pageNumber": 45,
