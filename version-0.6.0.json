      },
      "version": "78ca0a81d8058531c2e2e46235db2b832eae0213",
      "labels": [
        "Changes in 0.6.0"
      ]
    },
    {
      "noteVersion": 3,
      "content": "The “import” host call has become a more general “fetch” that can read from multiple data sources within the work-package or the array of import segments.",
      "date": 1738333705035,
      "author": "",
